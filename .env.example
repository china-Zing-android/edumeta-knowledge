FAST_ROUTER_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
TOOL_GATEWAY_NPM_REGISTRY=https://registry.npmmirror.com

# Optional host-port overrides. Container-to-container ports stay unchanged.
POSTGRES_PORT=5432
# OpenSearch is published on 0.0.0.0 so other containers can reach it through
# the host IP. Restrict this port with a firewall or trusted network.
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_BIND_HOST=127.0.0.1
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_PUBLISH_TIMEOUT_SECONDS=120
OPENSEARCH_RETRIEVAL_ATTEMPT_TIMEOUT_SECONDS=0.45
OPENSEARCH_RETRIEVAL_MAX_RETRIES=1
FAST_ROUTER_PORT=8000
MCP_PORT=8765

# Optional server-profile overrides used by compose.server.yaml. The committed
# server profile already has these defaults, so no file creation is required for
# the current server. Override only when the Tailscale IP or host ports change.
SERVER_TAILSCALE_HOST=100.74.163.113
POSTGRES_SERVER_PORT=15432
FAST_ROUTER_SERVER_PORT=8000
OPENSEARCH_SERVER_PORT=19200
MCP_SERVER_PORT=18765

# Keep localhost for single-machine use. For a private VPN such as Tailscale,
# set these to the server's VPN address. Do not expose unauthenticated endpoints
# on a public interface.
FAST_ROUTER_BIND_HOST=127.0.0.1
MCP_BIND_HOST=127.0.0.1

# External WeKnora. Keep the real API key in an untracked .env file.
WEKNORA_BASE_URL=
WEKNORA_API_KEY=
# Optional legacy fallback only. Normal multi-KB routing reads the actual KB ID
# from each university/source record in PostgreSQL and OpenSearch.
WEKNORA_KNOWLEDGE_BASE_ID=
# Optional but recommended when automatically creating a KB for a new school.
# Only its configuration is cloned; its documents are not searched or copied.
WEKNORA_KB_TEMPLATE_ID=
# Set false to keep URL extraction, L1 publication, and queued import jobs while
# preventing the worker from sending URLs to WeKnora. Set true and recreate the
# Fast Router to resume the queued jobs without re-uploading Markdown.
WEKNORA_IMPORT_ENABLED=true
WEKNORA_API_KEY_HEADER=X-API-Key
WEKNORA_SEARCH_TIMEOUT_SECONDS=2.8

FAST_ROUTER_TIMEOUT_MS=3500
TRACE_LOG_PATH=/app/data/traces/retrieval.jsonl
